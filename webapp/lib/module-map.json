  "globalRisks": [
    {
      "id": "lifecycle-events",
      "severity": "high",
      "title": "Connect lifecycle events are discontinued",
      "detail": "The 'enabled', 'disabled' and 'installed' lifecycle events are no longer sent after Forge adoption. Any app initialisation, provisioning or tenant-setup logic that depends on them must be rewritten.",
      "triggerKeys": ["lifecycle"]
    },
    {
